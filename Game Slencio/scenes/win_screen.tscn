[gd_scene format=3 uid="uid://win_screen_001"]

[ext_resource type="Script" path="res://scripts/win_screen.gd" id="1_win"]

[node name="WinScreen" type="CanvasLayer"]
script = ExtResource("1_win")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.0, 0.05, 0.0, 0.95)

[node name="VBox" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -140.0
offset_right = 150.0
offset_bottom = 140.0
alignment = 1

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
text = "VOCÊS ESCAPARAM!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 36

[node name="Subtitle" type="Label" parent="VBox"]
layout_mode = 2
text = "Parabéns!"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="Spacer" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 30)

[node name="RestartButton" type="Button" parent="VBox"]
layout_mode = 2
text = "Jogar Novamente"
theme_override_font_sizes/font_size = 24

[node name="Spacer2" type="Control" parent="VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)

[node name="QuitButton" type="Button" parent="VBox"]
layout_mode = 2
text = "Sair"
theme_override_font_sizes/font_size = 24

[connection signal="pressed" from="VBox/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="VBox/QuitButton" to="." method="_on_quit_pressed"]
